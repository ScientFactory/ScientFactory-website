---
import Prose from "../components/Prose.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  theme="light"
  title="Terms — ScientFactory"
  description="The terms for using Scient Desktop, the Scient phone app and Scient Connect."
>
  <Prose
    eyebrow="Last updated 12 November 2026"
    title="Terms of use."
    intro="These terms cover Scient Desktop, the Scient phone app, the hosted Scient app and the optional Scient Connect service."
  >
    <section class="content-section" aria-labelledby="terms-who">
      <p class="content-section__label">Who we are</p>
      <div class="content-section__body">
        <h2 id="terms-who">Who we are</h2>
        <p>
          Scient and ScientFactory are operated by GENORE PREV LTD, an Israeli company (company number 516936846). By using Scient you agree to these terms.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="terms-use">
      <p class="content-section__label">Using Scient</p>
      <div class="content-section__body">
        <h2 id="terms-use">Using Scient</h2>
        <p>
          Scient runs on your own computers. You choose which AI services, models and tools it uses, and you are responsible for your use of them under their own terms, including any fees they charge.
        </p>
        <p>
          Agents can read and change files, run commands and act in services you connect. Review what they do, keep backups of important work, and only connect accounts and computers you are allowed to use.
        </p>
        <p>
          Don't use Scient to break the law, to harm others, or to attack, overload or get around the security of our services or anyone else's.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="terms-account">
      <p class="content-section__label">Your account</p>
      <div class="content-section__body">
        <h2 id="terms-account">Your account</h2>
        <p>
          A Scient account is needed only for Scient Connect, the hosted app and the phone app. Keep your sign-in secure; you are responsible for activity on your account.
        </p>
        <p>
          You can delete your account at any time from the phone app's account settings, or by emailing <a href="mailto:support@scientfactory.com">support@scientfactory.com</a>. Deleting it removes your linked computers from Scient Connect.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="terms-content">
      <p class="content-section__label">Your work</p>
      <div class="content-section__body">
        <h2 id="terms-content">Your work stays yours</h2>
        <p>
          Your files, conversations and research results belong to you. Scient Connect carries them encrypted between your own devices; we don't claim any rights to them. Our <a href="/privacy">privacy notice</a> explains what information we collect.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="terms-service">
      <p class="content-section__label">The service</p>
      <div class="content-section__body">
        <h2 id="terms-service">The service</h2>
        <p>
          Scient is provided as is. We work to keep it reliable, but we don't promise it will always be available or free of errors, and AI output can be wrong. To the extent the law allows, we are not liable for indirect or consequential losses, or for loss of data.
        </p>
        <p>
          We may change Scient and these terms. When a change matters, we will say so in the app or on this page before it takes effect. We may suspend accounts that break these terms.
        </p>
        <p>
          Scient Desktop's source code is published under its own license, which governs the code itself.
        </p>
      </div>
    </section>

    <section class="content-section" aria-labelledby="terms-contact">
      <p class="content-section__label">Contact</p>
      <div class="content-section__body">
        <h2 id="terms-contact">Contact</h2>
        <p>
          These terms are governed by the laws of the State of Israel. Questions: <a href="mailto:support@scientfactory.com">support@scientfactory.com</a>.
        </p>
      </div>
    </section>
  </Prose>
</Layout>
