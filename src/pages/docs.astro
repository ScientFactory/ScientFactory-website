---
import ScientDocsShell from "../components/ScientDocsShell.astro";
import docsIndex from "../generated/scient-docs/index.json";
import { getScientDocsNavigationGroups } from "../lib/scient-docs-navigation";

const navigationGroups = getScientDocsNavigationGroups(docsIndex.pages);
---

<ScientDocsShell
  index={docsIndex}
  title="Documentation"
  description="Version-aware Scient documentation generated from the exact canonical Scient Desktop Help source."
>
  <div class="docs-landing">
    <header class="docs-landing__header">
      <p class="docs-landing__eyebrow">Documentation</p>
      <h1>Learn Scient from the source.</h1>
    </header>

    <div class="docs-search">
      <label for="docs-search-input">Search Scient Docs</label>
      <input
        id="docs-search-input"
        type="search"
        placeholder="Try PDF, provider, remote, MATLAB, or SyncTeX"
        autocomplete="off"
        data-docs-search
      />
      <p data-docs-search-status aria-live="polite">{docsIndex.pages.length} pages</p>
    </div>

    <div class="docs-topics">
      {
        navigationGroups.map((group) => {
          const { title: topic, primaryPages, secondaryPages } = group;

          return (
            <section class="docs-topic" data-docs-topic>
              <h2>{topic}</h2>
              <div class="docs-grid">
                {primaryPages.map((page) => (
                  <article
                    class="docs-card"
                    data-docs-card
                    data-docs-search-text={`${page.title} ${page.summary} ${topic} ${page.searchText}`.toLowerCase()}
                  >
                    <div>
                      <p>{topic}</p>
                      <h3><a href={page.url}>{page.title}</a></h3>
                      <span>{page.summary}</span>
                    </div>
                    <a class="docs-card__arrow" href={page.url} aria-label={`Read ${page.title}`}>→</a>
                  </article>
                ))}
              </div>
              {secondaryPages.length > 0 && (
                <details class="docs-topic__more" data-docs-more>
                  <summary>
                    <span class="docs-topic__more-closed">See {secondaryPages.length} more</span>
                    <span class="docs-topic__more-open">Show less</span>
                    <span class="docs-topic__more-arrow" aria-hidden="true">↓</span>
                  </summary>
                  <div class="docs-grid docs-grid--secondary">
                    {secondaryPages.map((page) => (
                      <article
                        class="docs-card"
                        data-docs-card
                        data-docs-search-text={`${page.title} ${page.summary} ${topic} ${page.searchText}`.toLowerCase()}
                      >
                        <div>
                          <p>{topic}</p>
                          <h3><a href={page.url}>{page.title}</a></h3>
                          <span>{page.summary}</span>
                        </div>
                        <a class="docs-card__arrow" href={page.url} aria-label={`Read ${page.title}`}>→</a>
                      </article>
                    ))}
                  </div>
                </details>
              )}
            </section>
          );
        })
      }
    </div>
  </div>
</ScientDocsShell>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
  const cards = [...document.querySelectorAll<HTMLElement>("[data-docs-card]")];
  const topics = [...document.querySelectorAll<HTMLElement>("[data-docs-topic]")];
  const disclosures = [...document.querySelectorAll<HTMLDetailsElement>("[data-docs-more]")];
  const status = document.querySelector<HTMLElement>("[data-docs-search-status]");
  let searchWasActive = false;

  function updateSearch(): void {
    const query = input?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    for (const card of cards) {
      const matches = query === "" || (card.dataset.docsSearchText ?? "").includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const topic of topics) {
      topic.hidden = !topic.querySelector<HTMLElement>("[data-docs-card]:not([hidden])");
    }
    for (const disclosure of disclosures) {
      const hasMatch = Boolean(disclosure.querySelector<HTMLElement>("[data-docs-card]:not([hidden])"));
      disclosure.hidden = query !== "" && !hasMatch;
      if (query !== "") {
        if (!searchWasActive) {
          disclosure.dataset.docsSearchPreviousOpen = disclosure.open ? "true" : "false";
        }
        disclosure.open = hasMatch;
      } else if (searchWasActive) {
        disclosure.open = disclosure.dataset.docsSearchPreviousOpen === "true";
        delete disclosure.dataset.docsSearchPreviousOpen;
      }
    }
    searchWasActive = query !== "";
    if (status) status.textContent = `${visible} ${visible === 1 ? "page" : "pages"}`;
  }

  input?.addEventListener("input", updateSearch);
</script>

<style>
  .docs-landing {
    max-width: 66rem;
  }

  .docs-landing__header {
    max-width: 53rem;
  }

  .docs-landing__eyebrow {
    margin: 0 0 0.75rem;
    color: var(--burgundy);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-landing__header h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.7rem, 6vw, 5.6rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .docs-search {
    margin: 3rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.55rem 1rem;
  }

  .docs-search label {
    grid-column: 1 / -1;
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 650;
  }

  .docs-search input {
    width: 100%;
    min-height: 3.2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
    color: var(--ink);
    font-size: 1rem;
  }

  .docs-search input:focus {
    border-color: var(--burgundy);
    outline: none;
    box-shadow: inset 0 0 0 1px var(--burgundy);
  }

  .docs-search p {
    margin: 0 0 0.9rem;
    color: var(--ink-dim);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .docs-topics {
    display: grid;
    gap: 3rem;
  }

  .docs-topic > h2 {
    margin: 0 0 0.9rem;
    color: var(--ink-dim);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .docs-grid--secondary {
    margin-top: 0.8rem;
  }

  .docs-topic__more {
    margin-top: 0.9rem;
  }

  .docs-topic__more summary {
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-radius: var(--radius-sm);
    color: var(--burgundy);
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 650;
    list-style: none;
  }

  .docs-topic__more summary::-webkit-details-marker {
    display: none;
  }

  .docs-topic__more summary:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .docs-topic__more-arrow {
    transition: transform 180ms var(--ease-out);
  }

  .docs-topic__more-open {
    display: none;
  }

  .docs-topic__more[open] .docs-topic__more-closed {
    display: none;
  }

  .docs-topic__more[open] .docs-topic__more-open {
    display: inline;
  }

  .docs-topic__more[open] .docs-topic__more-arrow {
    transform: rotate(180deg);
  }

  .docs-card {
    min-height: 10.5rem;
    padding: 1.25rem;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: var(--surface);
    transition: border-color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  .docs-card[hidden],
  .docs-topic[hidden] {
    display: none;
  }

  .docs-card:hover {
    border-color: rgba(84, 27, 29, 0.4);
    transform: translateY(-1px);
  }

  .docs-card p {
    margin: 0 0 0.45rem;
    color: var(--slate);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .docs-card h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.15rem;
  }

  .docs-card span {
    display: block;
    margin-top: 0.55rem;
    color: var(--ink-muted);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .docs-card__arrow {
    color: var(--burgundy);
    font-size: 1.25rem;
  }

  .docs-card a:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (max-width: 680px) {
    .docs-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
