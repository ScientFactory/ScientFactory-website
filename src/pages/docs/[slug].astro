---
import ScientDocsShell from "../../components/ScientDocsShell.astro";
import docsIndex from "../../generated/scient-docs/index.json";

interface MarkdownModule {
  Content: any;
}

const pageModules = import.meta.glob<MarkdownModule>("../../generated/scient-docs/pages/*.md", {
  eager: true,
});

export function getStaticPaths() {
  return docsIndex.pages.map((page) => ({ params: { slug: page.slug } }));
}

const page = docsIndex.pages.find((candidate) => candidate.slug === Astro.params.slug);
if (!page) throw new Error(`Unknown Scient Docs page: ${Astro.params.slug}`);
const pageModule = pageModules[`../../generated/scient-docs/pages/${page.slug}.md`];
if (!pageModule) throw new Error(`Missing generated Scient Docs module: ${page.slug}`);
const Content = pageModule.Content;
---

<ScientDocsShell
  index={docsIndex}
  title={page.title}
  description={page.summary}
  currentSlug={page.slug}
  currentPage={page}
>
  <article class="docs-prose">
    <Content />
  </article>
</ScientDocsShell>
