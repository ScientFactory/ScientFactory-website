{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "scientfactory-release-mirror",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-20",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/10 * * * *"],
  },
  "r2_buckets": [
    {
      "binding": "DESKTOP_DOWNLOADS",
      "bucket_name": "scient-downloads",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
